# Copy to .env (gitignored) or set in your environment / Vercel project.
# Server-side only — never expose these to the client.

# Required: OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...

# Default model for new conversations (the sidebar picker overrides per app).
# GPT-4o Audio was renamed on OpenRouter: openai/gpt-audio is the current id.
# Alternate in the picker: openai/gpt-audio-mini.
OPENROUTER_MODEL=openai/gpt-audio

# Optional: voice for spoken replies (gpt-audio streams pcm16). Default alloy.
# OPENROUTER_AUDIO_VOICE=alloy

# Optional: upstream override (used by the mock in local tests only).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1